# Server-only Vercel access token. Never prefix this with NEXT_PUBLIC_.
VERCEL_TOKEN=

# Required only for the hosted /api/mcp endpoint.
MCP_API_KEY=

# Optional default scope. Team IDs begin with team_.
VERCEL_TEAM_ID=

# Optional comma-separated project names/IDs that MCP may inspect.
VERCEL_PROJECT_ALLOWLIST=

# Optional request timeout; clamped to 1,000-30,000 ms.
VERCEL_REQUEST_TIMEOUT_MS=10000
