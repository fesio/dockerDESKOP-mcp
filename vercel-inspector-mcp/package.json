{
    "name": "@fesiomatyzacja/vercel-inspector-mcp",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "build:stdio": "esbuild src/stdio.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/stdio.js --sourcemap",
        "start": "next start",
        "stdio": "node dist/stdio.js",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "check": "npm run typecheck && npm run test && npm run build:stdio && npm run build"
    },
    "dependencies": {
        "@modelcontextprotocol/server": "2.0.0",
        "mcp-handler": "2.1.1",
        "next": "16.3.4",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "zod": "4.5.4"
    },
    "devDependencies": {
        "@types/node": "^24.0.0",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "esbuild": "^0.28.0",
        "typescript": "^6.0.0",
        "vitest": "5.0.0"
    },
    "engines": {
        "node": ">=22"
    }
}
