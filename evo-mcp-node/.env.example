# Evo MCP local runtime
LOCAL_MCP_PORT=8765
LOCAL_MCP_N8N_PORT=8766
LOG_LEVEL=INFO
MCP_TOOL_PROFILE=all
MCP_REQUIRE_AUTH=false
MCP_API_KEY=
MCP_TRUST_PROXY=false

# Programmer sandbox
PROGRAMMER_PROFILE=standard
PROGRAMMER_MAX_FILE_BYTES=2000000
PROGRAMMER_COMMAND_TIMEOUT=120
PROGRAMMER_ALLOWED_COMMANDS=git,python,python3,uv
PROGRAMMER_APPROVAL_SECRET=
PROGRAMMER_ALLOW_DOCKER=false
APPROVAL_DB_PATH=/data/approvals.sqlite3
TASK_DB_PATH=/data/tasks.sqlite3
TASK_ARTIFACT_DIR=/data/task-artifacts
TASK_WORKERS=2

# Source-first personal brain
BRAIN_VAULT_PATH=/brain
NOTION_TOKEN=
NOTION_BASE_URL=https://api.notion.com
NOTION_VERSION=2026-03-11
NOTEBOOKLM_BUNDLE_PATH=/data/notebooklm
NOTEBOOKLM_IMPORT_PATH=/brain/imports/notebooklm

# Optional local n8n 2.40.5
LOCAL_N8N_PORT=5678
N8N_ENCRYPTION_KEY=
GENERIC_TIMEZONE=Europe/Zurich

# n8n REST fallback (create in n8n user settings -> API)
N8N_BASE_URL=http://n8n:5678
N8N_API_KEY=
N8N_API_AUTH_SCHEME=api-key

# n8n instance-level MCP (enable in n8n MCP access settings)
N8N_MCP_URL=http://n8n:5678/mcp-server/http
N8N_MCP_TOKEN=
N8N_ALLOWED_HOSTS=n8n,localhost,127.0.0.1
N8N_TIMEOUT_SECONDS=30
N8N_VERIFY_TLS=true
N8N_MCP_ALLOWED_TOOLS=
